# Runtime app queries (recommended for Cloudflare Workers/serverless Prisma)
# Copy this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler
# Paste the raw value only. Do not wrap Cloudflare secret values in quotes.
# The exact hostname/username format varies by Supabase pooler type and region. Do not reconstruct it manually.
DATABASE_URL=PASTE_EXACT_TRANSACTION_POOLER_CONNECTION_STRING_HERE
# Prisma CLI / migrations / db push
# URL-encode special characters in the password, for example `@` -> `%40`.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres?schema=public
NEXTAUTH_URL=http://localhost:3000
# Production example: https://fitplus.lumoxtech.com.au
# Use `openssl rand -hex 32` and set a strong value here.
NEXTAUTH_SECRET=your-generated-secret
# Optional: set to true for temporary auth/session diagnostics.
AUTH_DEBUG=true
APP_BASE_URL=http://localhost:3000
# Production example: https://fitplus.lumoxtech.com.au
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_PRO=price_your_pro_price_id_here
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DEV_PREVIEW=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
DEMO_EMAIL=demo@fitpilot.ai
DEMO_PASSWORD=demo1234
